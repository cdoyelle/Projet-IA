{
  "expo": {
    "name": "TaskFlow",
    "slug": "taskflow-mobile",
    "scheme": "taskflow",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
